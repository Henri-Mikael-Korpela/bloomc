main :: proc() ->
    // Addition
    ->
        x := 4 + 5
        y := 10 + x
        z := 10 + x + 100
        print("Addition: X: {}, Y: {}, Z: {}\n", x, y, z)
    
    // Multiplication
    ->
        x := 4 * 5
        y := 10 * x * 5
        z := x * y
        print("Multiplication: X: {}, Y: {}, Z: {}\n", x, y, z)
    
    // Division
    ->
        x := 4 / 2
        y := 10 / x / 2
        z := x / y
        print("Division: X: {}, Y: {}, Z: {}\n", x, y, z)
    
    // Substraction
    ->
        x := 4 - 2
        y := 10 - x - 2
        z := x - y
        print("Substraction: X: {}, Y: {}, Z: {}\n", x, y, z)