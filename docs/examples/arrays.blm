main :: proc() ->
    // Array initialization with
    // deduced array length
    a := [const]Int{ 2, 5, 9 }
    b := a[1] + 1 + a[0]
    printf("A: %i, %i, %i\n", a[0], b, a[2])

    // Array initialization (on multiple lines)
    // with partial initialization using a range
    // and printing of array length
    c := [const]Int {
        1, 2,
        2..<4 = 3,
        4..<8 = 4
    }
    printf("C: %i, %i, %i\n", c[2], c[3], c[4])
    printf("C length: %i\n", length(c))

    // Array initialization with
    // an explicit array length
    d := [2]Int { 6, 12 }
    printf("D: #1: %i, #2: %i\n", d[0], d[1])

    // Array initialization
    // with partial initialization using a range
    e := [4]Int { 1, 1..<4 = 9 }
    printf("E: %i, %i, %i, %i\n", e[0], e[1], e[2], e[3])

    // Value assignments to array elements
    e[0] = 2
    e[1] = 3
    printf("E: %i, %i, %i, %i", e[0], e[1], e[2], e[3])