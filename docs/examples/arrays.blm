Event :: struct ->
    name: Str

main :: proc() ->
    // Array initialization with
    // deduced array length
    a := [const]Int{ 2, 5, 9 }
    b := a[1] + 1 + a[0]
    printf("A: %i, %i, %i\n", a[0], b, a[2])

    // Array initialization (on multiple lines)
    // with partial initialization using a range
    // and printing of array length
    c := [const]Int {
        1, 2,
        2..<4 = 3,
        4..<8 = 4
    }
    printf("C: %i, %i, %i\n", c[2], c[3], c[4])
    printf("C length: %i\n", length(c))

    // Array initialization with
    // an explicit array length
    d := [2]Int { 6, 12 }
    printf("D: #1: %i, #2: %i\n", d[0], d[1])

    // Array initialization
    // with partial initialization using a range
    e := [4]Int { 1, 1..<4 = 9 }
    print("E: {}, {}, {}, {}\n", e[0], e[1], e[2], e[3])

    // Value assignments to array elements
    e[0] = 2
    e[1] = 3
    print("E: {}, {}, {}, {}\n", e[0], e[1], e[2], e[3])

    // Array of structs
    events := [const]Event{
        Event { name = "Party" },
        Event { name = "Another party" }
    }
    print("Event #1: {}\n", events[0].name)
    print("Event #2: {}\n", events[1].name)

    // Array of structs with automatic type deduction on element struct type
    events2 := [const]Event{
        .{ name = "Party" },
        .{ name = "Another party" }
    }
    print("Event #1: {}\n", events2[0].name)
    print("Event #2: {}\n", events2[1].name)

    ->
        a := [const]Int{ 2, 8, 16, 24 }

        // Array slice from array, slice using whole range
        ->
            as := a[..]
            for x, i in as ->
                print("Array slice (whole range), index {} value: {}\n", i, x)
        
        // Array slice from array, slice using exclusive range
        ->
            as := a[1..<3]
            for x, i in as ->
                print("Array slice (exclusive range), index {} value: {}\n", i, x)
        
        // Array slice from array, slice using counted range
        ->
            as := a[2..+2]
            for x, i in as ->
                print("Array slice (counted range), index {} value: {}\n", i, x)