// Simple calendar keeping app
fclose :: proc(stream: ^FILE) -> foreign
fopen  :: proc(path: CStr, mode: CStr) ^FILE -> foreign
fwrite :: proc(content: CStr, size: Int, count: Int, stream: ^FILE) Int -> foreign

File :: struct ->
    _ptr: ^FILE
    path: Str

file_close :: proc(file: ^File) ->
    fclose(file._ptr)

file_open_for_write :: proc(path: Str) File ->
    path_cstr := clone_to_cstr(path, context.temp_allocator)
    mode := clone_to_cstr("w", context.temp_allocator)
    fptr := fopen(path_cstr, mode)
    File { path = path, _ptr = fptr }

file_write :: proc(file: ^File, content: []U8) ->
    fwrite(CStr(content), 1, length(content), file._ptr)

Event :: struct ->
    id: Int
    name: Str

main :: proc() ->
    EVENT_NAME_MAX_LENGTH :: 255

    events := [const]Event {
        .{ id = 1, name = "My event" },
        .{ id = 2, name = "My other event" },
    }
    e1 := events[0]
    print("Event #1: {}\n", e1.name)

    f := file_open_for_write("calendar-db")
    defer file_close(%f)

    print("Output file path: {}\n", f.path)

    buffer := [4 + 1 + EVENT_NAME_MAX_LENGTH]U8{}
    for event in events ->
        name_len := length_in_bytes(event.name)
        buffer[0..<4] = []U8(IntLE(event.id))
        buffer[4] = name_len
        buffer[5..+name_len] = []U8(event.name)
        buffer_len := 4 + 1 + name_len
        file_write(%f, buffer[0..+buffer_len])
