package henri.http_server

SocketAddr :: struct ->
    sa_family: Int
    sa_data: ^U8

// C Standard procedures
free       :: proc(ptr: ^CVoid) -> foreign
memcpy     :: proc(dst: ^U8, src: ^CVoid, n: Int) -> foreign
realloc    :: proc(ptr: ^U8, size: Int) ^U8 -> foreign

// Linux socket API — sys/socket.h, netinet/in.h, unistd.h included automatically
accept     :: proc(sockfd: Int, addr: ^SocketAddr, addrlen: ^CVoid) Int -> foreign
bind       :: proc(sockfd: Int, addr: ^CVoid, addrlen: Int) Int -> foreign
close      :: proc(fd: Int) -> foreign
listen     :: proc(sockfd: Int, backlog: Int) Int -> foreign
recv       :: proc(sockfd: Int, buf: ^CVoid, len: Int, flags: Int) Int -> foreign
socket     :: proc(domain: Int, type: Int, protocol: Int) Int -> foreign
send       :: proc(sockfd: Int, buf: ^U8, len: Int, flags: Int) Int -> foreign
setsockopt :: proc(sockfd: Int, level: Int, optname: Int, optval: ^CVoid, optlen: Int) Int -> foreign

StrBuilder :: struct ->
    data: ^U8
    len: Int
    cap: Int

str_builder_create :: proc() StrBuilder ->
    return StrBuilder{}

str_builder_destroy :: proc(sb: ^StrBuilder) ->
    if sb.data not= nil ->
        free(^CVoid(sb.data))

str_builder_write_str :: proc(sb: ^StrBuilder, value: Str) ->
    new_len := sb.len + length_in_bytes(value)
    cap := sb.cap
    if cap < new_len ->
        new_cap := new_len * 2
        // No need to use malloc since realloc can do
        // malloc also with certain arguments
        new_data := realloc(sb.data, new_cap)
        if new_data not= nil ->
            sb.data = new_data
            sb.cap = new_cap
    memcpy(sb.data + sb.len, value.data, length_in_bytes(value))
    sb.len = new_len

HTTPHeaderName :: enum Str ->
    CONTENT_LENGTH = "Content-Length"
    CONTENT_TYPE   = "Content-Type"

main :: proc(args: []Str) ->
    server_fd := socket(AF_INET, SOCK_STREAM, 0)
    if server_fd < 0 ->
        print("Failed to create socket\n")
        return 1

    // Allow address reuse so the server can restart without waiting for TIME_WAIT
    optval := 1
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, %optval, 4)

    // Build a sockaddr_in (16 bytes) on the stack as a raw byte array:
    //   [0..1]  sin_family = AF_INET = 2  (host byte order)
    //   [2..3]  sin_port   = 8889 in network byte order (big-endian): 0x22=34, 0xB9=185
    //   [4..7]  sin_addr   = INADDR_ANY = 0
    //   [8..15] sin_zero   = 0 (padding)
    addr := [16]U8{}
    addr[0] = 2
    addr[2] = 34
    addr[3] = 185

    bind_result := bind(server_fd, addr, 16)
    if bind_result < 0 ->
        print("Failed to bind to port 8889\n")
        return 1

    listen_result := listen(server_fd, 10)
    if listen_result < 0 ->
        print("Failed to listen on socket\n")
        return 1

    print("Listening on http://localhost:8889\n")

    client_addr     := SocketAddr{}
    client_addr_len := type_info_of(client_addr).size_in_bytes
    recv_buf        := [64]U8{}

    for ->
        client_fd := accept(server_fd, ^CVoid(%client_addr), %client_addr_len)
        if client_fd < 0 ->
            break
        defer close(client_fd)

        recv(client_fd, recv_buf, 64, 0)

        RESPONSE_CONTENT :: \
            """
            HTTP/1.1 200 OK\r\n
            ${HTTPHeaderName.CONTENT_LENGTH}: 13\r\n
            ${HTTPHeaderName.CONTENT_TYPE}: text/plain\r\n
            \r\n
            """

        response_buf := str_builder_create()
        defer str_builder_destroy(%response_buf)

        str_builder_write_str(%response_buf, RESPONSE_CONTENT)
        str_builder_write_str(%response_buf, "Hello, world!")

        send(client_fd, response_buf.data, response_buf.len, 0)
