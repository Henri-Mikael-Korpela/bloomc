main :: proc() ->
    // Infinite loop with break statement
    i := 0
    for ->
        if i == 5 ->
            break
        i += 1
    printf("First loop passed!\n")

    // For loop with exclusive range
    for i in 0..<10 ->
        print("Exclusive range, index: {}\n", i)

    for i in 0..<3 + 7 ->
        print("Exclusive range (with arithemetic expression), index: {}\n", i)

    ->
        a := [const]Int { 3, 6, 9 }
        for i in 0..<length(a) ->
            print("Exclusive range (with length proc call), index: {}\n", i)

    ->
        a := [const]Int { 3, 6, 9 }
        for i in 0..<length(a) + 2 ->
            print("Exclusive range (with length proc call and arithemetic expression), index: {}\n", i)

    // For loop with inclusive range
    for i in 0..=10 ->
        print("Inclusive range, index: {}\n", i)

    // For loop with counted range
    for i in 2..+5 ->
        print("Counted range, index: {}\n", i)

    x := 4
    for i in 2..+x ->
        print("Counted range with x, index: {}\n", i)
    
    // For if loop which is like while loop in C
    j := 0
    for if j < 10 ->
        print("For if, j = {}\n", j)
        j += 1

    // For-in loop with array, with variable binding
    a := [const]Int { 1, 2, 3 }
    for x, i in a ->
        print("For-in loop with array with variable binding, X: {}, index {}\n", x, i)

    // For-in loop with array, without variable binding
    for x, i in []Int { 1, 1..<4 = 9 } ->
        print("For-in loop with array without variable binding, X: {}, index {}\n", x, i)