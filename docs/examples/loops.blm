main :: proc() ->
    // Infinite loop with break statement
    i := 0
    for ->
        if i == 5 ->
            break
        i += 1
    printf("First loop passed!\n")

    // For loop with exclusive range
    for i in 0..<10 ->
        print("Exclusive range, index: {}\n", i)

    // For loop with counted range
    for i in 2..+5 ->
        print("Counted range, index: {}\n", i)
    
    // For if loop which is like while loop in C
    j := 0
    for if j < 10 ->
        print("For if, j = {}\n", j)
        j += 1
