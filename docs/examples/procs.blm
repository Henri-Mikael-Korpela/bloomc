// No parameters, no return type
print_thing :: proc() ->
    printf("Print a thing\n")

// Some parameters, return type
sum :: proc(a: Int, b: Int) Int ->
    a + b

// Returning an array from procedure
foo_return_array :: proc() [3]Int ->
    a := [3]Int{ 2, 8, 12 }
    a[0] = 4
    a

// Returning an array slice
foo_return_array_slice :: proc(a: [4]Int) []Int ->
    a[1..<3]

Person :: struct ->
    name: Str

// Returning a struct object
foo_return_struct_object :: proc() Person ->
    return Person{ name = "Bob" }

main :: proc() ->
    print_thing()
    printf("Sum: %i\n", sum(5, 10))

    ->
        a := foo_return_array()
        print("A: {}, {}, {}\n", a[0], a[1], a[2])

    ->
        a := [4]Int{ 1, 2, 3, 4 }
        as := foo_return_array_slice(a)
        print("A: {}, {}\n", as[0], as[1])
    
    p := foo_return_struct_object()
    print("Person name: {}\n", p.name)