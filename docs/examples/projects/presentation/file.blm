package henri.presentation

fclose :: proc(stream: ^FILE) -> foreign
fopen  :: proc(path: CStr, mode: CStr) ^FILE -> foreign
fread  :: proc(buffer: ^CVoid, size: Int, count: Int, stream: ^FILE) Int -> foreign
fwrite :: proc(content: CStr, size: Int, count: Int, stream: ^FILE) Int -> foreign

File :: struct ->
    _ptr: ^FILE
    path: Str

file_close :: proc(file: ^File) ->
    fclose(file._ptr)

file_open_for_read :: proc(path: Str) File ->
    path_cstr := clone_to_cstr(path, context.temp_allocator)
    mode := clone_to_cstr("r", context.temp_allocator)
    fptr := fopen(path_cstr, mode)
    return File { path = path, _ptr = fptr }

file_open_for_write :: proc(path: Str) File ->
    path_cstr := clone_to_cstr(path, context.temp_allocator)
    mode := clone_to_cstr("w", context.temp_allocator)
    fptr := fopen(path_cstr, mode)
    return File { path = path, _ptr = fptr }

file_read_bytes_into_buffer :: proc(file: ^File, target_buffer: []U8) ->
    BUFFER_ELEMENT_TYPE_SIZE :: type_info_of(target_buffer[0]).size_in_bytes

    fread(^CVoid(target_buffer), BUFFER_ELEMENT_TYPE_SIZE, length(target_buffer), file._ptr)

file_write :: proc(file: ^File, content: []U8) ->
    fwrite(CStr(content), 1, length(content), file._ptr)

file_write_str :: proc(file: ^File, content: Str) ->
    content_cstr := clone_to_cstr(content, context.temp_allocator)
    fwrite(content_cstr, 1, length_in_bytes(content), file._ptr)
