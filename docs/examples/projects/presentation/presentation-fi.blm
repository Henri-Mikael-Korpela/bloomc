package henri.presentation.presentation_fi

import "./file"
import "./str-builder"

Template :: struct ->
    name: Str

Slide :: struct ->
    title: Str
    content: Str
    template: ^Template

main :: proc() ->
    title_template := Template{
        name = "title"
    }

    slides := [const]Slide{
        .{
            title = "Bloom-ohjelmointikieli",
            content = "<h1>Bloom-ohjelmointikieli</h1>",
            template = %title_template,
        },
        .{
            title = "Proseduurit",
            content = "<h1>Proseduurit</h1>",
            template = %title_template,
        },
    }

    for slide, i in slides ->
        print("Slide #{}: {}", i + 1, slide.title)

    output := henri.presentation.str_builder_create(context.temp_allocator)

    henri.presentation.str_builder_write_str(%output,
        """
        <!DOCTYPE html>
        <html>
        
        <head>
            <meta charset="utf-8">
        </head>

        <body>
        """
    )
    for slide in slides ->
        henri.presentation.str_builder_write_str(%output, slide.content)
    henri.presentation.str_builder_write_str(%output, "</body></html>")

    f := henri.presentation.file_open_for_write("presentation.html")
    defer henri.presentation.file_close(%f)

    output_str := henri.presentation.str_builder_to_str(%output)
    henri.presentation.file_write_str(%f, output_str)
