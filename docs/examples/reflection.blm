MyStruct :: struct ->
    age: Int

main :: proc() ->
    // Names and sizes of built-in types
    ->
        t :: type_info_of(Bool)
        print("{} size: {}\n", t.name, t.size_in_bytes)
    ->
        t :: type_info_of(Int)
        print("{} size: {}\n", t.name, t.size_in_bytes)
    ->
        t :: type_info_of(Str)
        print("{} size: {}\n", t.name, t.size_in_bytes)
    ->
        t :: type_info_of(U8)
        print("{} size: {}\n", t.name, t.size_in_bytes)

    // Sizes of custom structs
    print("MyStruct size: {}\n", type_info_of(MyStruct).size_in_bytes)

    // Sizes based on type deduction
    print("Type from {}, size: {}\n", "Hello", type_info_of("Hello").size_in_bytes)

    mys := MyStruct{}
    print("Type from {}, size: {}\n", "mys.age", type_info_of(mys.age).size_in_bytes)