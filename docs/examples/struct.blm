MyStruct :: struct ->
    days: Int
    years: Int

main :: proc() ->
    // Default initialization of structure instance
    s :: MyStruct {}
    print("Days: {}, Years: {}\n", s.days, s.years)

    // Modify struct member
    s.years = 5 + 10
    print("Days: {}, Years: {}\n", s.days, s.years + s.years)

    // Initialization of structure with all values
    t :: MyStruct { days = 15, years = 2002 }
    print("Days: {}, Years: {}\n", t.days, t.years)

    // Initialization spanning multiple lines with trailing comma
    u :: MyStruct {
        days = 15,
        years = 2002,
    }
    print("Days: {}, Years: {}\n", u.days, u.years)
