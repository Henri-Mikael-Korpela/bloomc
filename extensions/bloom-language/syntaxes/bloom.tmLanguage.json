{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bloom",
  "scopeName": "source.bloom",
  "fileTypes": ["blm"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#proc-definition" },
    { "include": "#struct-definition" },
    { "include": "#constant-definition" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#special-variable" },
    { "include": "#number" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.bloom",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.bloom",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bloom",
          "match": "\\\\[nrt\"\\\\]"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.integer.bloom",
      "match": "\\b[0-9]+\\b"
    },
    "proc-definition": {
      "comment": "Matches: name :: proc",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(::)\\s*(proc)\\b",
      "captures": {
        "1": { "name": "entity.name.function.bloom" },
        "2": { "name": "keyword.operator.definition.bloom" },
        "3": { "name": "keyword.other.bloom" }
      }
    },
    "struct-definition": {
      "comment": "Matches: TypeName :: struct",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(::)\\s*(struct)\\b",
      "captures": {
        "1": { "name": "entity.name.type.bloom" },
        "2": { "name": "keyword.operator.definition.bloom" },
        "3": { "name": "keyword.other.bloom" }
      }
    },
    "constant-definition": {
      "comment": "Matches: NAME :: or name :: (non-proc/struct definitions)",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(::)(?!\\s*(proc|struct)\\b)",
      "captures": {
        "1": { "name": "entity.name.constant.bloom" },
        "2": { "name": "keyword.operator.definition.bloom" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bloom",
          "match": "\\b(break|else|for|if|in|pass)\\b"
        },
        {
          "name": "keyword.other.bloom",
          "match": "\\b(const|defer|foreign|proc|struct|type_info_of)\\b"
        },
        {
          "name": "constant.language.boolean.bloom",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.bloom",
      "match": "\\b(Bool|CStr|FILE|Int|Str|U8)\\b"
    },
    "special-variable": {
      "name": "variable.language.bloom",
      "match": "\\bcontext\\b"
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.bloom" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.bloom",
          "match": "\\.\\.[<+=]"
        },
        {
          "name": "keyword.operator.arrow.bloom",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.bloom",
          "match": "==|<"
        },
        {
          "name": "keyword.operator.assignment.bloom",
          "match": ":=|\\+="
        },
        {
          "name": "keyword.operator.arithmetic.bloom",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.address.bloom",
          "match": "%"
        },
        {
          "name": "keyword.operator.deref.bloom",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.bloom",
          "match": "="
        },
        {
          "name": "punctuation.separator.type.bloom",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.bloom",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.bloom",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.bloom",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.bloom",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.bloom",
          "match": "[{}]"
        }
      ]
    }
  }
}
